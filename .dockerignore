# VCS / CI
.git/
.github/
.gitignore
.gitattributes

# 编辑器 / IDE 本地配置
.cursor/
.claude/
.codebuddy/
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Node / 前端
# 注意：前端是独立镜像（context 为 ./frontend），根 .dockerignore 对它无效；
# 本镜像（server）不引用 frontend/，可直接排除。
**/node_modules/
frontend/

# Gradle 缓存与构建产物（builder stage 内会重新构建）
**/.gradle/
.gradle/
**/build/
build/

# 日志 / 临时文件
logs/
tmp/
temp/
*.log
*.pid
