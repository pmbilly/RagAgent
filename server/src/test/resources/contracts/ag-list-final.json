 source documents.\nFor a task that needs Wiki evidence:\n- Find an entry point with wiki_search, or read the index when the user requests an overview. Restrict the lookup to the relevant bound knowledge base.\n- Read a relevant page with wiki_read_page when search summaries do not contain enough evidence. Follow links only to resolve a specific gap; a fixed number of pages or hops is not required.\n- For exact quotes, detailed code, or disputed facts, inspect the original documents referenced by the page using an available reader. A generated Wiki page is not automatically more authoritative than its sources or newer verified evidence.\n- If sources conflict, compare their dates, scope, and provenance and explain unresolved differences. Report a supported Wiki defect with wiki_flag_issue when that tool is available and the report is relevant to the task.\n- Use verified [[slug|display name]] links when Wiki navigation helps the user. Source citation syntax and whether citations are enabled are controlled by the runtime protocol.\nThis is a default research workflow, not a requirement to search the Wiki for every message. Honor the user's current source selection and use the tools actually provided; do not infer tool type from its name.\n","system_prompt_id":"wiki_researcher","context_template":"","modelId":"","rerank_model_id":"","temperature":0.7,"max_completion_tokens":0,"thinking":false,"citation_enabled":true,"max_iterations":30,"allowed_tools":["wiki_search","wiki_read_page","wiki_read_source_doc","wiki_flag_issue"],"mcp_selection_mode":"","mcp_services":null,"skills_selection_mode":"","selected_skills":null,"kb_selection_mode":"all","knowledge_bases":null,"retrieve_kb_only_when_mentioned":false,"retain_retrieval_history":false,"image_upload_enabled":false,"vlm_model_id":"","audio_upload_enabled":false,"asr_model_id":"","image_storage_provider":"","supported_file_types":null,"attachment_image_understanding":false,"data_analysis_enabled":false,"faq_priority_enabled":false,"faq_direct_answer_threshold":0,"faq_score_boost":0,"web_search_enabled":false,"web_search_max_results":5,"web_fetch_enabled":false,"multi_turn_enabled":true,"history_turns":10,"embedding_top_k":10,"keyword_threshold":0.3,"vector_threshold":0.5,"rerank_top_k":10,"rerank_threshold":0.3,"enable_query_expansion":false,"enable_rewrite":false,"rewrite_prompt_system":"","rewrite_prompt_user":"","fallback_strategy":"model","fallback_response":"","fallback_prompt":"","question_suggestions":{"starters":{"enabled":true,"mode":"hybrid","items":[],"count":6},"follow_ups":{"enabled":false,"mode":"hybrid","count":3,"categories":["clarify","deepen","action"],"max_context_turns":2,"suppress_on_fallback":true,"suppress_when_answer_asks_question":true,"knowledge_fallback":true,"allow_regenerate":false}}},"createdAt":"0001-01-01T00:00:00Z","updatedAt":"0001-01-01T00:00:00Z","deletedAt":null},{"id":"builtin-data-analyst","name":"数据分析师","description":"专业的数据分析智能体，支持对 CSV/Excel 文件进行 SQL 查询和统计分析","avatar":"📊","is_builtin":true,"tenantId":10005,"created_by":"","config":{"agent_mode":"smart-reasoning","agent_type":"data-analysis","system_prompt":"You are WeKnora Data Analyst, specializing in analysis of the user's CSV and Excel data with DuckDB.\nFor a data-analysis task:\n- Inspect the target table with data_schema before writing SQL if its current schema is not already available. Reuse a schema obtained for the same unchanged table during this task.\n- Use data_analysis with the supplied document handle and a read-only query. Follow its tool definition and reported validation errors; do not modify source data.\n- Use exact table and column names from the schema. Quote identifiers with double quotes. Limit exploratory output, then compute the aggregates needed to answer the question.\n- Check units, time ranges, nulls, joins, and aggregation assumptions before interpreting the result. Distinguish observed values from inference.\n- Present an appropriate table, chart, or explanation, including assumptions and material limitations. Do not force a SQL call for a question that needs no data access.\nUse only tools available in this turn; source selection and output conventions are defined by the runtime sections.\n","system_prompt_id":"data_analyst","context_template":"","modelId":"","rerank_model_id":"","temperature":0.3,"max_completion_tokens":0,"thinking":false,"citation_enabled":true,"max_iterations":30,"allowed_tools":["data_schema","data_analysis"],"mcp_selection_mode":"","mcp_services":null,"skills_selection_mode":"","selected_skills":null,"kb_selection_mode":"all","knowledge_bases":null,"retrieve_kb_only_when_mentioned":false,"retain_retrieval_history":false,"image_upload_enabled":false,"vlm_model_id":"","audio_upload_enabled":false,"asr_model_id":"","image_storage_provider":"","supported_file_types":["csv","xlsx"],"attachment_image_understanding":false,"data_analysis_enabled":false,"faq_priority_enabled":false,"faq_direct_answer_threshold":0,"faq_score_boost":0,"web_search_enabled":false,"web_search_max_results":5,"web_fetch_enabled":false,"multi_turn_enabled":true,"history_turns":10,"embedding_top_k":5,"keyword_threshold":0.3,"vector_threshold":0.5,"rerank_top_k":5,"rerank_threshold":0.3,"enable_query_expansion":false,"enable_rewrite":false,"rewrite_prompt_system":"","rewrite_prompt_user":"","fallback_strategy":"model","fallback_response":"","fallback_prompt":"","question_suggestions":{"starters":{"enabled":true,"mode":"hybrid","items":[],"count":6},"follow_ups":{"enabled":false,"mode":"hybrid","count":3,"categories":["clarify","deepen","action"],"max_context_turns":2,"suppress_on_fallback":true,"suppress_when_answer_asks_question":true,"knowledge_fallback":true,"allow_regenerate":false}}},"createdAt":"0001-01-01T00:00:00Z","updatedAt":"0001-01-01T00:00:00Z","deletedAt":null},{"id":"5473f276-c245-4b4e-8c24-c109e57274d2","name":"ag-full (副本)","description":"full config agent","avatar":"robot","is_builtin":false,"tenantId":10005,"creat