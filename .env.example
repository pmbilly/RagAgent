# =====================================================================
# ragagent-java 环境变量配置示例
# ---------------------------------------------------------------------
# 使用说明：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 替换所有占位符为实际值（尤其标 ⚠️ 必填 的项）
#   3. .env 已在 .gitignore，不会被提交
#
# 消费方：
#   - scripts/dev-env.sh 读本文件（SYSTEM_AES_KEY/DB_*/REDIS_PASSWORD 六个必读键），
#     供 java-server-up.sh / token.sh / 全部测试脚本使用；
#   - docker-compose.yml 的 postgres/redis 容器密码需与此处保持一致。
#
# 命名对照 Go 仓 .env.example：变量名保持一致（DB_/REDIS_/SYSTEM_AES_KEY/…），
# 仅端口按本仓 dev 习惯（postgres 15432 / redis 16379 / app 8080）。
# =====================================================================

# ── 数据库（⚠️ 必填；与 docker-compose.yml 的 postgres 容器一致） ─────────
# 驱动固定 postgres；pg_search（ParadeDB BM25）与 pgvector 扩展为检索引擎依赖，
# 需用 paradedb/paradedb 镜像（见 docker-compose.yml）。
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=15432
DB_USER=postgres
DB_PASSWORD=postgres123!@#
DB_NAME=WeKnora

# ── Redis（⚠️ 必填；stream 管理器与 IM 去重/队列跨实例面） ─────────────────
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=redis123!@#

# ── 认证与空间隔离（⚠️ SYSTEM_AES_KEY 必填） ─────────────────────────────
# 32 字节 AES 密钥：模型凭证加密 / 临时文档 / 租户隔离族共用。
# ⚠️ 更换后已加密列不可解——建库前定好，勿随意轮换。
SYSTEM_AES_KEY=0123456789abcdef0123456789abcdef

# ── 文档解析（docreader gRPC 服务；docker-compose 起在 50051） ────────────
DOCREADER_ADDR=localhost:50051

# ── 服务端口 ────────────────────────────────────────────────────────────
# Java 后端监听端口（application.yml 读 ${SERVER_PORT:8080}；本仓 dev 惯例 8083，
# 避开旧仓 8082 本地走查环境）。
SERVER_PORT=8083

# ── 文档原始文件持久存储（本地 dev 必填） ────────────────────────────────
# 必须放持久目录，严禁 /tmp：macOS 定期清 /tmp 会导致已入库文档原始文件丢失
# （列表/检索正常但 preview 全 500、重处理报 failed to read file，实测踩坑 2026-09-28）。
# 建议仓库外持久路径，如 ~/ragagent-data/files。
LOCAL_STORAGE_BASE_DIR=/Users/billy/ragagent-data/files

# ── 检索引擎（可选；HybridSearch 的 env-store 引擎选择） ──────────────────
# 缺省/为空 = 检索引擎关闭（HybridSearch 返回空，与 Go 同形）。
# postgres = pgvector + ParadeDB BM25（本仓 compose 的镜像自带两种扩展）。
# 其余取值（elasticsearch_v7/v8、qdrant、milvus、weaviate、doris、sqlite、
# tencent_vectordb、opensearch）为外部 store 传输层，随 provider 批接线。
# RETRIEVE_DRIVER=postgres

# ── 流管理器（可选） ────────────────────────────────────────────────────
# memory（缺省，进程内）/ redis（跨实例，A/B 双端共享键空间时两侧同设）。
# STREAM_MANAGER_TYPE=redis
# STREAM_MANAGER_REDIS_PREFIX=stream:

# ── tenant_skill 安装（可选） ────────────────────────────────────────────
# 内置模型声明（对照 Go BUILTIN_MODELS_CONFIG；缺省 no-op）。
# BUILTIN_MODELS_CONFIG=/path/to/builtin_models.yaml
# 安装沙箱 TTL、卡死 TTL 等随安装管线批（provider-XDEP）。
